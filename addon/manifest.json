{
  "manifest_version": 3,
  "name": "theUnfound Theme para Thunderbird",
  "short_name": "theUnfound Theme",
  "version": "0.4.0",
  "description": "O theUnfound Theme deixa o Thunderbird com a cara de um app moderno: barra lateral escura em grafite com trilho de contas recolhível, lista de mensagens com avatar e prévia, painel de leitura limpo, claro e escuro. Só aparência; nada sai daqui.",
  "author": "Sergio Batera",
  "browser_specific_settings": {
    "gecko": {
      "id": "theme@theunfound.com.br",
      "strict_min_version": "140.0",
      "strict_max_version": "158.*"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": ["storage"],
  "experiment_apis": {
    "unfoundTheme": {
      "schema": "experiments/unfoundTheme/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["unfoundTheme"]],
        "script": "experiments/unfoundTheme/implementation.js",
        "events": ["startup"]
      }
    }
  }
}
